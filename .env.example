# Telegram bot token từ @BotFather (bắt buộc để chạy thật)
TELEGRAM_BOT_TOKEN=

# API Squeekchain (read-only)
API_BASE=https://api.squeekchain.com/v1

# SQLite
DB_PATH=/home/dinhtien02/squeek-holder-bot/data/bot.db

# Telegram user ID của admin, cách nhau bằng dấu phẩy
ADMIN_IDS=

# Nhịp poll (ms)
POLL_STATUS_MS=15000
POLL_WALLET_MS=45000

# Giới hạn & ngưỡng mặc định
MAX_WALLETS=5
DEFAULT_THRESHOLD_SQK=0.5

# TUỲ CHỌN: chỉ dùng để đọc claimable() từng token (optimizer chính xác).
# Hiện deployment Sepolia trả revert → để trống thì bot dùng API và ghi "estimated".
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# MINING_ADDRESS=0xcd46990f8349057335289ef282c276204b6cdc62

# Giờ gửi digest (0-23, giờ máy)
DIGEST_HOUR=9

# healthchecks.io ping URL (tuỳ chọn nhưng nên có)
HEALTHCHECK_URL=

# 1 = không kết nối Telegram, chỉ poll dữ liệu
DRY_RUN=0

# Ghi log ra file (tuỳ chọn)
LOG_PATH=
